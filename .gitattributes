# Normalize line endings to LF in the repository.
# Files are committed with LF; working copies stay LF on every platform too,
# so CRLF-only diffs never appear.
* text=auto eol=lf

*.sh   text eol=lf
*.yml  text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
Dockerfile text eol=lf

# Never touch line endings in binary files.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.zip  binary
*.gz   binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ico  binary
